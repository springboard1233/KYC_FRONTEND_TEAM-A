# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=False
SECRET_KEY=a_very_strong_random_secret_key

FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8001


# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600

ADMIN_DEFAULT_PASSWORD=admin123
TEST_DEFAULT_PASSWORD=test123


# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/kyc_database
MONGO_DB_NAME=kyc_database

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Application Settingspython scripts/reset_admin_password.py admin123
BACKEND_PORT=5000
UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH=16777216

# OCR Settings
TESSERACT_PATH=/usr/bin/tesseract
POPPLER_PATH=/usr/bin

# Data Paths
SYNTHETIC_DATA_PATH=../data/synthetic/
PRACTICE_SAMPLES_PATH=../data/practice_samples/
EXPORTS_PATH=../exports/


